# ============================================================
# Liguita — variables d'environnement
# Copier en .env.local et renseigner. NE JAMAIS COMMITER .env.local
# ============================================================
#
#     cp .env.example .env.local
#
# Ce modèle est commité : il documente les variables attendues et sert de référence
# à la CI. Seul `.env.local` est ignoré par git.
#
# Référence : docs/Liguita_Plan_Implementation_v3.md §5.1

# ---------- Supabase ----------
# Tableau de bord Supabase → « Project Settings → API ».
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ Serveur uniquement. Ne jamais importer dans un composant client.
# Cette clé contourne toutes les politiques de sécurité au niveau des lignes :
# elle n'est lue que par des route handlers, des server actions et des traitements
# différés. Ni préfixe NEXT_PUBLIC_, ni import depuis un fichier 'use client'.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Application ----------
# URL canonique, sans barre oblique finale.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_COUNTRY=TD
NEXT_PUBLIC_DEFAULT_CURRENCY=XAF
# Les numéros tchadiens comportent 8 chiffres après +235.
NEXT_PUBLIC_DEFAULT_PHONE_PREFIX=+235

# ---------- Paiement (Sprint 6) ----------
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_MERCHANT_CODE=
MOOV_MERCHANT_ID=
MOOV_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---------- Notifications ----------
SMS_PROVIDER_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ---------- Base de données locale (développement uniquement) ----------
# Renseigné par `supabase start`. À laisser vide si vous travaillez sur le projet
# hébergé. Aucune sensibilité : ces valeurs ne valent que sur la machine du développeur.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
